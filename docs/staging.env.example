# Exclusiv test. Nu completa cu chei de producție.
# Clerk: aplicația ASMM, Development, pagina API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Stripe: Test mode / Sandbox, pagina API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Completat după pornirea Stripe CLI listen, pentru testarea plăților.
STRIPE_WEBHOOK_SECRET=
# 1 = MongoDB temporar local; nu folosește baza reală și se șterge la oprire.
ASMM_EPHEMERAL_DB=1
# 1 după configurarea whsec: bilet fictiv și plăți în sandbox.
ASMM_STAGING_SEED=0
# Pentru verificare locală pe Atlas: 0 mai sus și parola utilizatorului dedicat.
# Scriptul construiește adresa în memorie, codificând corect caracterele speciale.
ATLAS_STAGING_PASSWORD=
# Pentru staging online, în Vercel se configurează MONGODB_URI cu utilizatorul dedicat.
MONGODB_URI=
MONGODB_DB_NAME=asmm_staging
NEXT_PUBLIC_BASE_URL=http://localhost:3000
